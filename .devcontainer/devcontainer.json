{
  "name": "REALM public contributor",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "developer",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "8gb"
  },
  "containerEnv": {
    "CARGO_BUILD_JOBS": "2",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0"
  },
  "postCreateCommand": "python3 tools/dev.py fast",
  "shutdownAction": "stopContainer"
}
